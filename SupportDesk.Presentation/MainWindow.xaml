<Window
    x:Class="SupportDesk.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SupportDesk">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="{StaticResource AppBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBackgroundBrush}"
            CornerRadius="0,20,20,0">

            <StackPanel
                Padding="20,30"
                Spacing="10">

                <!-- APP NAME -->
                <TextBlock
                    Text="SupportDesk"
                    Foreground="White"
                    FontSize="26"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,40"/>

                <!-- DASHBOARD -->
                <Button
                    Command="{Binding NavigateToDashboardCommand}"
                    Style="{StaticResource NavigationButtonStyle}">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="14">

                        <FontIcon
                            Glyph="&#xE80F;"
                            FontSize="18"
                            Foreground="#F8FAFC"/>

                        <TextBlock
                            Text="Dashboard"
                            Foreground="#F8FAFC"
                            FontSize="15"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!-- TICKETS -->
                <Button
                    Command="{Binding NavigateToTicketsCommand}"
                    Style="{StaticResource NavigationButtonStyle}">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="14">

                        <FontIcon
                            Glyph="&#xE8A5;"
                            FontSize="18"
                            Foreground="#F8FAFC"/>

                        <TextBlock
                            Text="Tickets"
                            Foreground="#F8FAFC"
                            FontSize="15"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!-- CUSTOMERS -->
                <Button
                    Command="{Binding NavigateToCustomersCommand}"
                    Style="{StaticResource NavigationButtonStyle}">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="14">

                        <FontIcon
                            Glyph="&#xE77B;"
                            FontSize="18"
                            Foreground="#F8FAFC"/>

                        <TextBlock
                            Text="Customers"
                            Foreground="#F8FAFC"
                            FontSize="15"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </StackPanel>

        </Border>

        <!-- CONTENT -->
        <Frame
            x:Name="MainFrame"
            Grid.Column="1"/>

    </Grid>

</Window>