<Page
    x:Class="SupportDesk.Presentation.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer>

        <StackPanel
            Padding="42"
            Spacing="30">

            <!-- HEADER -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="Dashboard"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Overview of your support tickets"
                    Style="{StaticResource PageSubtitleStyle}"/>

            </StackPanel>

            <!-- DASHBOARD CARDS -->
            <Grid ColumnSpacing="22">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- NEW -->
                <Button
                    Grid.Column="0"
                    Style="{StaticResource DashboardCardButtonStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border
                            Width="48"
                            Height="6"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Background="{StaticResource NewAccentBrush}"/>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,22,0,0"
                            Spacing="6">

                            <TextBlock
                                Text="New"
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock
                                Text="{Binding NewCount}"
                                Style="{StaticResource CardNumberStyle}"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="6">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{StaticResource NewAccentBrush}"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="Open tickets"
                                Style="{StaticResource SmallLabelStyle}"/>

                        </StackPanel>

                    </Grid>

                </Button>

                <!-- IN PROGRESS -->
                <Button
                    Grid.Column="1"
                    Style="{StaticResource DashboardCardButtonStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border
                            Width="48"
                            Height="6"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Background="{StaticResource ProgressAccentBrush}"/>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,22,0,0"
                            Spacing="6">

                            <TextBlock
                                Text="In Progress"
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock
                                Text="{Binding InProgressCount}"
                                Style="{StaticResource CardNumberStyle}"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="6">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{StaticResource ProgressAccentBrush}"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="Currently being handled"
                                Style="{StaticResource SmallLabelStyle}"/>

                        </StackPanel>

                    </Grid>

                </Button>

                <!-- RESOLVED -->
                <Button
                    Grid.Column="2"
                    Style="{StaticResource DashboardCardButtonStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border
                            Width="48"
                            Height="6"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Background="{StaticResource ResolvedAccentBrush}"/>

                        <StackPanel
                            Grid.Row="1"
                            Margin="0,22,0,0"
                            Spacing="6">

                            <TextBlock
                                Text="Resolved"
                                Style="{StaticResource CardTitleStyle}"/>

                            <TextBlock
                                Text="{Binding ResolvedCount}"
                                Style="{StaticResource CardNumberStyle}"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="6">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{StaticResource ResolvedAccentBrush}"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="Completed tickets"
                                Style="{StaticResource SmallLabelStyle}"/>

                        </StackPanel>

                    </Grid>

                </Button>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</Page>