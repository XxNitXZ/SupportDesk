<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Views.TicketDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            Padding="32"
            Spacing="16">

            <TextBlock
                Text="Ticket Details"
                FontSize="32"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="Title"
                FontSize="16"/>

            <TextBlock
                Text="{Binding Ticket.Title}"
                FontSize="22"/>

            <TextBlock
                Text="Description"
                FontSize="16"
                Margin="0,8,0,0"/>

            <TextBlock
                Text="{Binding Ticket.Description}"
                TextWrapping="Wrap"/>

            <TextBlock
                Text="Customer"
                FontSize="16"
                Margin="0,8,0,0"/>

            <TextBlock
                Text="{Binding Ticket.Customer.Name}"/>

            <TextBlock
                Text="Priority"
                FontSize="16"
                Margin="0,8,0,0"/>

            <TextBlock
                Text="{Binding Ticket.Priority}"/>

            <TextBlock
                Text="Status"
                FontSize="16"
                Margin="0,8,0,0"/>

            <TextBlock
                Text="{Binding Ticket.Status}"/>

            <TextBlock
                Text="Technician"
                FontSize="16"
                Margin="0,8,0,0"/>

            <TextBlock
                Text="{Binding Ticket.Technician}"/>

            <TextBlock
                Text="Created"
                FontSize="16"
                Margin="0,8,0,0"/>

            <TextBlock
                Text="{Binding Ticket.CreatedAt}"/>

        </StackPanel>
    </ScrollViewer>

</Page>