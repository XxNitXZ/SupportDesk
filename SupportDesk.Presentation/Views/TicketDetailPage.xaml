<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SupportDesk.Presentation.Views.TicketDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer>

        <StackPanel
            Padding="42"
            Spacing="24">

            <!-- HEADER -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="Ticket Details"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="View and manage support ticket"
                    Style="{StaticResource PageSubtitleStyle}"/>

            </StackPanel>

            <!-- TICKET DETAILS -->
            <Border
                Style="{StaticResource ContentCardStyle}"
                Padding="24">

                <StackPanel Spacing="18">

                    <!-- TITLE -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Title"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"/>

                        <TextBox
                            Text="{Binding Title, Mode=TwoWay}"
                            Style="{StaticResource InputTextBoxStyle}"/>

                    </StackPanel>

                    <!-- DESCRIPTION -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Description"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"/>

                        <TextBox
                            Text="{Binding Description, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            Height="120"
                            Style="{StaticResource InputTextBoxStyle}"/>

                    </StackPanel>

                    <!-- CUSTOMER -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Customer"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"/>

                        <TextBlock
                            Text="{Binding CustomerName}"
                            FontSize="16"
                            Foreground="{StaticResource MainTextBrush}"/>

                    </StackPanel>

                    <!-- PRIORITY -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Priority"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"/>

                        <ComboBox
                            ItemsSource="{Binding Priorities}"
                            SelectedItem="{Binding Priority, Mode=TwoWay}"
                            Style="{StaticResource InputComboBoxStyle}"/>

                    </StackPanel>

                    <!-- STATUS -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Status"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"/>

                        <ComboBox
                            ItemsSource="{Binding Statuses}"
                            SelectedItem="{Binding Status, Mode=TwoWay}"
                            Style="{StaticResource InputComboBoxStyle}"/>

                    </StackPanel>

                    <!-- TECHNICIAN -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Technician"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"/>

                        <TextBox
                            Text="{Binding Technician, Mode=TwoWay}"
                            PlaceholderText="Enter technician"
                            Style="{StaticResource InputTextBoxStyle}"/>

                    </StackPanel>

                    <!-- CREATED -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Created"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MainTextBrush}"/>

                        <TextBlock
                            Text="{Binding CreatedAt}"
                            Foreground="{StaticResource MainTextBrush}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- COMMENTS -->
            <Border
                Style="{StaticResource ContentCardStyle}"
                Padding="24">

                <StackPanel Spacing="16">

                    <TextBlock
                        Text="Comments"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource MainTextBrush}"/>

                    <!-- EXISTING COMMENTS -->
                    <ListView ItemsSource="{Binding Comments}">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Background="{StaticResource AppBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                    <StackPanel Spacing="6">

                                        <TextBlock
                                            Text="{Binding CreatedAt}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource MainTextBrush}"/>

                                        <TextBlock
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap"
                                            Foreground="{StaticResource MainTextBrush}"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                    <!-- NEW COMMENT -->
                    <TextBox
                        PlaceholderText="Write a comment..."
                        Text="{Binding NewComment, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Height="90"
                        Style="{StaticResource InputTextBoxStyle}"/>

                    <Button
                        Content="Add Comment"
                        Click="AddCommentButton_Click"
                        HorizontalAlignment="Right"
                        Width="140"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                </StackPanel>

            </Border>

            <!-- BUTTONS -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                HorizontalAlignment="Right">

                <Button
                    Content="Save Changes"
                    Click="SaveButton_Click"
                    Width="160"
                    Style="{StaticResource PrimaryButtonStyle}"/>

                <Button
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Width="120"
                    Style="{StaticResource SecondaryButtonStyle}"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</Page>