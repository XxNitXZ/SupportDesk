<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SupportDesk.Presentation.Views.TicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Tickets"
                FontSize="32"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="{StaticResource MainTextBrush}"/>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10">

                <Button
                    x:Name="BackToDashboardButton"
                    Content="← Dashboard"
                    Click="BackToDashboardButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="Collapsed"/>

                <Button
                    Content="New Ticket"
                    Click="NewTicketButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"/>

            </StackPanel>

        </Grid>

        <!-- SEARCH + FILTER -->
        <Grid
            x:Name="SearchAndFilterGrid"
            Grid.Row="1"
            Margin="0,20,0,0"
            ColumnSpacing="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="0"
                PlaceholderText="Search by ticket title or customer name..."
                TextChanged="SearchTextBox_TextChanged"
                Style="{StaticResource InputTextBoxStyle}"
                Height="44"/>

            <ComboBox
                x:Name="StatusFilterComboBox"
                Grid.Column="1"
                PlaceholderText="Filter by status"
                SelectionChanged="StatusFilterComboBox_SelectionChanged"
                Style="{StaticResource InputComboBoxStyle}"
                Height="44">

                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="New"/>
                <ComboBoxItem Content="In Progress"/>
                <ComboBoxItem Content="Resolved"/>

            </ComboBox>

        </Grid>

        <!-- AMOUNT -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="4"
            Margin="0,12,0,20">

            <TextBlock
                Text="Amount of tickets:"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{StaticResource MainTextBrush}"/>

            <TextBlock
                Text="{Binding Tickets.Count}"
                FontSize="18"
                Foreground="{StaticResource MainTextBrush}"/>

        </StackPanel>

        <!-- TICKETS -->
        <ListView
            Grid.Row="3"
            ItemsSource="{Binding Tickets}"
            IsItemClickEnabled="True"
            ItemClick="TicketsList_ItemClick">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="18"
                        Margin="0,0,0,12"
                        Background="White"
                        CornerRadius="8">

                        <StackPanel Spacing="8">

                            <!-- TITLE -->
                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#111827"/>

                            <!-- DESCRIPTION -->
                            <StackPanel Orientation="Horizontal" Spacing="4">

                                <TextBlock
                                    Text="Description:"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>

                                <TextBlock
                                    Text="{Binding Description}"
                                    Foreground="#374151"
                                    TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- CUSTOMER -->
                            <StackPanel Orientation="Horizontal" Spacing="4">

                                <TextBlock
                                    Text="Customer:"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>

                                <TextBlock
                                    Text="{Binding Customer.Name}"
                                    Foreground="#374151"/>

                            </StackPanel>

                            <!-- STATUS -->
                            <StackPanel Orientation="Horizontal" Spacing="4">

                                <TextBlock
                                    Text="Status:"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>

                                <TextBlock
                                    Text="{Binding Status}"
                                    Foreground="#374151"/>

                            </StackPanel>

                            <!-- PRIORITY -->
                            <StackPanel Orientation="Horizontal" Spacing="4">

                                <TextBlock
                                    Text="Priority:"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>

                                <TextBlock
                                    Text="{Binding Priority}"
                                    Foreground="#374151"/>

                            </StackPanel>

                            <!-- TECHNICIAN -->
                            <StackPanel Orientation="Horizontal" Spacing="4">

                                <TextBlock
                                    Text="Technician:"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>

                                <TextBlock
                                    Text="{Binding Technician, TargetNullValue='No technician'}"
                                    Foreground="#374151"/>

                            </StackPanel>

                            <!-- CREATED -->
                            <StackPanel Orientation="Horizontal" Spacing="4">

                                <TextBlock
                                    Text="Created:"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>

                                <TextBlock
                                    Text="{Binding CreatedAt}"
                                    Foreground="#374151"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Page>