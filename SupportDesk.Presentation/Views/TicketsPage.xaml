<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Views.TicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Tickets"
            FontSize="32"
            FontWeight="SemiBold"
            Margin="0,0,0,20"/>

        <TextBlock
                Text="{Binding Tickets.Count}"
                FontSize="20"
                Margin="0,0,0,20"/>

        <ListView
            Grid.Row="1"
            ItemsSource="{Binding Tickets}">



            <ListView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Padding="16"
                        Margin="0,0,0,10"
                        Tapped="Ticket_Tapped">
                        

                        <StackPanel>

                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="{Binding Description}"
                                Margin="0,5,0,0"/>

                            <TextBlock
                                Text="{Binding Status}"
                                Margin="0,5,0,0"/>

                            <TextBlock
                                Text="{Binding Priority}"
                                Margin="0,5,0,0"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</Page>