<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Views.NewTicketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                Text="New Ticket"
                Style="{StaticResource PageTitleStyle}"/>

            <TextBlock
                Text="Create a new support ticket"
                Style="{StaticResource PageSubtitleStyle}"/>

        </StackPanel>


        <!-- FORM -->
        <Grid
            Grid.Row="1"
            Margin="0,24,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- TITLE -->
            <StackPanel
                Grid.Row="0"
                Spacing="6">

                <TextBlock
                    Text="Title"
                    Foreground="{StaticResource MainTextBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"/>

                <TextBox
                    PlaceholderText="Enter ticket title"
                    Text="{Binding Title, Mode=TwoWay}"
                    Style="{StaticResource InputTextBoxStyle}"
                    Height="44"/>

            </StackPanel>


            <!-- DESCRIPTION -->
            <StackPanel
                Grid.Row="1"
                Margin="0,16,0,0"
                Spacing="6">

                <TextBlock
                    Text="Description"
                    Foreground="{StaticResource MainTextBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"/>

                <TextBox
                    PlaceholderText="Describe the problem"
                    Text="{Binding Description, Mode=TwoWay}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="90"
                    VerticalContentAlignment="Top"
                    Style="{StaticResource InputTextBoxStyle}"/>

            </StackPanel>


            <!-- BOTTOM AREA -->
            <Grid
                Grid.Row="2"
                Margin="0,20,0,0"
                ColumnSpacing="40">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- LEFT HALF -->
                <StackPanel
                    Grid.Column="0"
                    Spacing="14">

                    <!-- CUSTOMER -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Customer"
                            Foreground="{StaticResource MainTextBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"/>

                        <ComboBox
                            PlaceholderText="Select customer"
                            ItemsSource="{Binding Customers}"
                            DisplayMemberPath="Name"
                            SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                            Style="{StaticResource InputComboBoxStyle}"
                            Height="44"
                            HorizontalAlignment="Stretch"/>

                    </StackPanel>


                    <!-- PRIORITY -->
                    <StackPanel Spacing="6">

                        <TextBlock
                            Text="Priority"
                            Foreground="{StaticResource MainTextBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"/>

                        <ComboBox
                            PlaceholderText="Select priority"
                            ItemsSource="{Binding Priorities}"
                            SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                            Style="{StaticResource InputComboBoxStyle}"
                            Height="44"
                            HorizontalAlignment="Stretch"/>

                    </StackPanel>

                </StackPanel>


                <!-- RIGHT HALF -->
                <StackPanel
                    Grid.Column="1"
                    Spacing="30"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right">

                    <Button
                        Content="Create Ticket"
                        Click="CreateTicketButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44"
                        Width="200"/>

                    <Button
                        Content="Cancel"
                        Click="CancelButton_Click"
                        Style="{StaticResource DangerButtonStyle}"
                        Height="44"
                        Width="200"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Page>