<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Views.NewTicketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer>
        <StackPanel
            Padding="42"
            Spacing="24">

            <!-- HEADER -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="New Ticket"
                    Style="{StaticResource PageTitleStyle}"/>

                <TextBlock
                    Text="Create a new support ticket"
                    Style="{StaticResource PageSubtitleStyle}"/>

            </StackPanel>

            <!-- TITLE -->
            <StackPanel Spacing="8">

                <TextBlock
                    Text="Title"
                    Foreground="{StaticResource MainTextBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"/>

                <TextBox
                    PlaceholderText="Enter ticket title"
                    Text="{Binding Title, Mode=TwoWay}"
                    Style="{StaticResource InputTextBoxStyle}"/>

            </StackPanel>

            <!-- DESCRIPTION -->
            <StackPanel Spacing="8">

                <TextBlock
                    Text="Description"
                    Foreground="{StaticResource MainTextBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"/>

                <TextBox
                    PlaceholderText="Describe the problem"
                    Text="{Binding Description, Mode=TwoWay}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="130"
                    VerticalContentAlignment="Top"
                    Style="{StaticResource InputTextBoxStyle}"/>

            </StackPanel>

            <!-- CUSTOMER / PRIORITY -->
            <Grid ColumnSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- CUSTOMER -->
                <StackPanel
                    Grid.Column="0"
                    Spacing="8">

                    <ComboBox
                        Header="Customer"
                        PlaceholderText="Select customer"
                        ItemsSource="{Binding Customers}"
                        DisplayMemberPath="Name"
                        SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                        Style="{StaticResource InputComboBoxStyle}"/>

                </StackPanel>

                <!-- PRIORITY -->
                <StackPanel
                        Grid.Column="1"
                        Spacing="8">

                    <TextBlock
                        Text="Priority"
                        Foreground="{StaticResource MainTextBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"/>

                    <ComboBox
                        PlaceholderText="Select priority"
                        ItemsSource="{Binding Priorities}"
                        SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"
                        Style="{StaticResource InputComboBoxStyle}"/>

                </StackPanel>

            </Grid>

            <!-- CREATE -->
            <Button
                Content="Create Ticket"
                HorizontalAlignment="Right"
                Click="CreateTicketButton_Click"
                Style="{StaticResource PrimaryButtonStyle}"/>

        </StackPanel>
    </ScrollViewer>

</Page>