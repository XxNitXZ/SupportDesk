<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SupportDesk.Presentation.Views.CustomerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                Text="Customer"
                Style="{StaticResource PageTitleStyle}"/>

            <TextBlock
                Text="Update customer information"
                Style="{StaticResource PageSubtitleStyle}"/>

        </StackPanel>

        <!-- FORM -->
        <Grid
            Grid.Row="1"
            Margin="0,24,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- NAME -->
            <StackPanel
                Grid.Row="0"
                Spacing="6">

                <TextBlock
                    Text="Name"
                    Foreground="{StaticResource MainTextBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"/>

                <TextBox
                    PlaceholderText="Customer name"
                    Text="{Binding Name, Mode=TwoWay}"
                    Style="{StaticResource InputTextBoxStyle}"
                    Height="44"/>

            </StackPanel>

            <!-- EMAIL -->
            <StackPanel
                Grid.Row="1"
                Margin="0,16,0,0"
                Spacing="6">

                <TextBlock
                    Text="Email"
                    Foreground="{StaticResource MainTextBrush}"
                    FontSize="14"
                    FontWeight="SemiBold"/>

                <TextBox
                    PlaceholderText="Customer email"
                    Text="{Binding Email, Mode=TwoWay}"
                    Style="{StaticResource InputTextBoxStyle}"
                    Height="44"/>

            </StackPanel>

            <!-- BUTTONS -->
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                Spacing="12"
                Margin="0,24,0,0"
                HorizontalAlignment="Right">

                <Button
                    Content="Save Changes"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="160"/>

                <Button
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="120"/>

            </StackPanel>

        </Grid>

    </Grid>

</Page>